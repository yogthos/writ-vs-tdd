GRADE: earliest disagrees on 190 inputs, e.g.
{:args [{:rooms #{1}, :bookings {0 {:id 0, :room 1, :start 1, :end 6, :who 0}}, :next-id 1} 5 0 5], :want nil, :got [1 0]}
GRADE: book-earliest disagrees on 190 inputs, e.g.
{:args [{:rooms #{1}, :bookings {0 {:id 0, :room 1, :start 1, :end 6, :who 0}}, :next-id 1} 5 0 5 1], :want [{:rooms #{1}, :bookings {0 {:id 0, :room 1, :start 1, :end 6, :who 0}}, :next-id 1} nil], :got [{:rooms #{1}, :bookings {0 {:id 0, :room 1, :start 1, :end 6, :who 0}, 1 {:id 1, :room 1, :start 0, :end 5, :who 1}}, :next-id 2} [1 0]]}
GRADE: book-all disagrees on 580 inputs, e.g.
{:args [{:rooms #{2}, :bookings {}, :next-id 0} [{:who 0, :len 1} {:who 2, :len 6}] 1 7], :want [{:rooms #{2}, :bookings {0 {:id 0, :room 2, :start 1, :end 2, :who 0}}, :next-id 1} [[2 1] nil]], :got [{:rooms #{2}, :bookings {0 {:id 0, :room 2, :start 1, :end 2, :who 0}, 1 {:id 1, :room 2, :start 1, :end 7, :who 2}}, :next-id 2} [[2 1] [2 1]]]}
GRADE: free? disagrees on 85 inputs, e.g.
{:args [{:rooms #{0}, :bookings {0 {:id 0, :room 0, :start 0, :end 4, :who 2}}, :next-id 1} 0 2 8], :want false, :got true}
GRADE: book disagrees on 85 inputs, e.g.
{:args [{:rooms #{0}, :bookings {0 {:id 0, :room 0, :start 0, :end 4, :who 2}}, :next-id 1} 0 2 8 1], :want [{:rooms #{0}, :bookings {0 {:id 0, :room 0, :start 0, :end 4, :who 2}}, :next-id 1} nil], :got [{:rooms #{0}, :bookings {0 {:id 0, :room 0, :start 0, :end 4, :who 2}, 1 {:id 1, :room 0, :start 2, :end 8, :who 1}}, :next-id 2} 1]}
