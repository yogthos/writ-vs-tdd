GRADE: earliest disagrees on 295 inputs, e.g.
{:args [{:rooms #{1}, :bookings {0 {:id 0, :room 1, :start 3, :end 9, :who 2}}, :next-id 1} 2 1 11], :want [1 1], :got [1 9]}
GRADE: book-earliest disagrees on 295 inputs, e.g.
{:args [{:rooms #{2}, :bookings {0 {:id 0, :room 2, :start 2, :end 4, :who 2}}, :next-id 1} 1 0 19 0], :want [{:rooms #{2}, :bookings {0 {:id 0, :room 2, :start 2, :end 4, :who 2}, 1 {:id 1, :room 2, :start 0, :end 1, :who 0}}, :next-id 2} [2 0]], :got [{:rooms #{2}, :bookings {0 {:id 0, :room 2, :start 2, :end 4, :who 2}, 1 {:id 1, :room 2, :start 4, :end 5, :who 0}}, :next-id 2} [2 4]]}
GRADE: book-all disagrees on 354 inputs, e.g.
{:args [{:rooms #{3 2}, :bookings {}, :next-id 0} [{:who 1, :len 2} {:who 0, :len 3}] 2 10], :want [{:rooms #{3 2}, :bookings {0 {:id 0, :room 2, :start 2, :end 4, :who 1}, 1 {:id 1, :room 3, :start 2, :end 5, :who 0}}, :next-id 2} [[2 2] [3 2]]], :got [{:rooms #{3 2}, :bookings {0 {:id 0, :room 2, :start 2, :end 4, :who 1}, 1 {:id 1, :room 2, :start 4, :end 7, :who 0}}, :next-id 2} [[2 2] [2 4]]]}
exit 0
